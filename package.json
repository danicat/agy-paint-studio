{
  "name": "agy-paint-studio",
  "version": "1.0.0",
  "description": "Interactive multi-layer drawing, PSD editing, and Gemini AI image refinement studio for Antigravity.",
  "type": "module",
  "main": "server/index.mjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/bundle-studio-artifact.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "antigravity",
    "plugin",
    "sidecar",
    "paint-studio",
    "canvas",
    "psd",
    "image-editor",
    "generative-ui",
    "gemini"
  ],
  "author": "Google LLC",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "ag-psd": "^23.0.0",
    "google-auth-library": "^11.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
